{
  "name": "forge_generate",
  "description": "Forge generation JOB: grounds on /knowledge, asks the agent for a full architecture DAG + tasks, repairs to a DAG, and persists a new project. Runs minutes; async.",
  "type": "JOB",
  "visibility": "POD",
  "code": { "$file": "code.py" },
  "permissions": {
    "grants": [
      { "resource_type": "datastore_table", "resource_name": "projects",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"] },
      { "resource_type": "datastore_table", "resource_name": "nodes",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"] },
      { "resource_type": "datastore_table", "resource_name": "edges",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"] },
      { "resource_type": "datastore_table", "resource_name": "tasks",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"] },
      { "resource_type": "folder", "resource_name": "/knowledge",
        "permission_ids": ["folder.read"] },
      { "resource_type": "agent", "resource_name": "hello",
        "permission_ids": ["agent.read", "agent.execute"] }
    ]
  }
}
